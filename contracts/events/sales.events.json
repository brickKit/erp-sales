{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "erp-sales 事件清单",
  "note": "Schema 演进铁律：只增不删不改（决策 19）。消费者宽容反序列化。",
  "envelope": {
    "description": "所有事件共用的信封。三个 Header 字段由 be-sdk 自动填/校验（§3.10）",
    "required": ["subject", "aggregate_id", "version", "trace_id", "causation_id", "hop_count", "occurred_at"],
    "properties": {
      "subject":      { "type": "string", "pattern": "^[a-z]+\\.[a-z-]+\\.[a-z-]+\\.v[0-9]+$" },
      "aggregate_id": { "type": "string" },
      "version":      { "type": "integer", "description": "消费者只在严格大于本地当前值时更新（决策 43）" },
      "trace_id":     { "type": "string" },
      "causation_id": { "type": "string" },
      "hop_count":    { "type": "integer", "maximum": 5, "description": "> 5 直接丢弃进 DLQ（决策 42）" },
      "occurred_at":  { "type": "string", "format": "date-time" }
    }
  },
  "events": [
    {
      "subject": "sales.order.created.v1",
      "grade": "core",
      "note": "核心交易事件：必须持久化、幂等、进死信队列（§3.10 事件分级）。⚠️ 在 ConfirmOrder 成功后发，不是 CreateOrder——草稿单不该产生应收凭证（设计计划 §4）。消费者是 erp-finance，生成应收凭证 + 累加已用额度。",
      "payload": {
        "type": "object",
        "required": ["order_id", "order_no", "customer_id", "items", "total_amount", "version"],
        "properties": {
          "order_id":     { "type": "string" },
          "order_no":     { "type": "string" },
          "customer_id":  { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["product_id", "qty", "subtotal"],
              "properties": {
                "product_id": { "type": "string" },
                "qty":        { "type": "string" },
                "subtotal":   { "type": "string" }
              }
            }
          },
          "total_amount": { "type": "string", "description": "decimal-as-string" },
          "version":      { "type": "integer" }
        }
      }
    },
    {
      "subject": "sales.order.cancelled.v1",
      "grade": "core",
      "payload": {
        "type": "object",
        "required": ["order_id"],
        "properties": {
          "order_id": { "type": "string" },
          "reason":   { "type": "string" }
        }
      }
    },
    {
      "subject": "sales.order.shipped.v1",
      "grade": "core",
      "payload": {
        "type": "object",
        "required": ["order_id", "items"],
        "properties": {
          "order_id": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["product_id", "qty"],
              "properties": {
                "product_id": { "type": "string" },
                "qty":        { "type": "string" }
              }
            }
          }
        }
      }
    }
  ]
}
